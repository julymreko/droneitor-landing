{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droneitor-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Worker híbrido: Cloudflare sirve primero los ficheros de ./public y sólo
  // ejecuta src/index.js cuando la ruta no es un asset (o sea, /api/lead).
  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "droneitor-leads",
      // Creada con --location enam: el INSERT se espera antes de responder al
      // visitante, y el público de la landing está en Florida.
      "database_id": "912da2e8-f8b1-49c4-8328-1c676e125cef"
    }
  ],

  // Reporte semanal interno de leads. El cron no fija qué semana se reporta —
  // la ventana se deriva del instante de ejecución — así que basta con disparar
  // holgadamente dentro del lunes de Miami.
  //
  // 06:00 UTC = 02:00 EDT en verano y 01:00 EST en invierno. Las dos caen
  // después de la medianoche de Miami en cualquier época del año, que es lo que
  // hace falta para que la semana anterior ya esté cerrada. Un `0 4 * * 1` sería
  // exactamente medianoche en verano: carrera con el propio límite del periodo.
  "triggers": {
    "crons": ["0 6 * * 1"]
  },

  "vars": {
    // Nombre de la pestaña de la hoja de cálculo donde se añaden los leads.
    "SHEETS_TAB": "Leads",

    // Remitente del correo de bienvenida. El dominio tiene que estar
    // verificado en la cuenta de Zeptomail o el envío falla.
    "ZEPTOMAIL_FROM_EMAIL": "no-reply@droneitor.com",
    "ZEPTOMAIL_FROM_NAME": "Droneitor",

    // --- Reporte semanal ---------------------------------------------------
    // "test" manda SOLO a Julian. Cambiar a "production" es el único paso que
    // habilita a Marco, y hay que hacerlo a propósito: resolveMode() trata
    // cualquier otro valor (typo, var sin definir) como "test".
    "REPORT_MODE": "test",

    // Buzón contestable, distinto del no-reply de los correos al lead.
    "REPORT_FROM_EMAIL": "support@droneitor.com",
    "REPORT_FROM_NAME": "Droneitor Reports",

    "WEEKLY_REPORT_TEST_RECIPIENTS": "Julian Cely <cj.cely@hotmail.com>",
    "WEEKLY_REPORT_PRODUCTION_RECIPIENTS": "Marco Beas <droneitor1983@gmail.com>, Julian Cely <cj.cely@hotmail.com>"
  },

  "observability": {
    "enabled": true
  }

  // Secretos (NO van aquí — `wrangler secret put <NOMBRE>`):
  //   TURNSTILE_SECRET_KEY
  //   GOOGLE_SA_EMAIL
  //   GOOGLE_SA_PRIVATE_KEY
  //   GOOGLE_SHEET_ID
  //   ZEPTOMAIL_API_KEY            token del Mail Agent de no-reply@ (correos al lead)
  //   REPORT_ZEPTOMAIL_API_KEY     token del Mail Agent de support@ (reporte semanal)
  //
  // Son dos porque en Zeptomail cada Mail Agent firma con su propio Send Mail
  // Token y el remitente tiene que pertenecer al agente que firma. Si falta el
  // segundo, el reporte usa el primero — y dará 401 mientras support@ siga en
  // otro agente.
}
