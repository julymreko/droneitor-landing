{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droneitor-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Worker híbrido: Cloudflare sirve primero los ficheros de ./public y sólo
  // ejecuta src/index.js cuando la ruta no es un asset (o sea, /api/lead).
  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "droneitor-leads",
      // Creada con --location enam: el INSERT se espera antes de responder al
      // visitante, y el público de la landing está en Florida.
      "database_id": "912da2e8-f8b1-49c4-8328-1c676e125cef"
    }
  ],

  "vars": {
    // Nombre de la pestaña de la hoja de cálculo donde se añaden los leads.
    "SHEETS_TAB": "Leads"
  },

  "observability": {
    "enabled": true
  }

  // Secretos (NO van aquí — `wrangler secret put <NOMBRE>`):
  //   TURNSTILE_SECRET_KEY
  //   GOOGLE_SA_EMAIL
  //   GOOGLE_SA_PRIVATE_KEY
  //   GOOGLE_SHEET_ID
}
